<?xml version="1.0" encoding="utf-8"?>
<!--
  Glassmorphism simulation for Glance suggestion pills.
  RemoteViews cannot apply blur/compositing, so we simulate it with:
    - A dark semi-transparent solid fill (#1A1A24 ≈ obsidian at ~10% brightness)
    - A 1dp violet stroke to mimic an iridescent edge light
    - 24dp corner radius for a fully-rounded pill shape
  Usage: GlanceModifier.background(ImageProvider(R.drawable.glass_pill_background))
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Dark fill: #1A1A24 = ARGB(FF,1A,1A,24) — deep navy-black -->
    <solid android:color="#1A1A24" />
    <!-- Faux iridescent border: LiquidViolet #B200FF at 70% alpha -->
    <stroke
        android:width="1dp"
        android:color="#B2B200FF" />
    <!-- Full pill rounding -->
    <corners android:radius="24dp" />
</shape>
