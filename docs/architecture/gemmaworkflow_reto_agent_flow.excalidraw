    {
      "id": "text_example",
      "type": "text",
      "x": 118,
      "y": 1044,
      "width": 904,
      "height": 96,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1029,
      "version": 1,
      "versionNonce": 100029,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Example request path: \"send message to Maya saying hi, invite him to a meeting next Friday at 6, add it to calendar\"\nAgent 0: t1 send_message target=Maya, t2 create_event time=next Friday at 6\nAgent 1: t1 -> sms.compose, t2 -> calendar.create_event\nAgent 2: sms.phone needs_tool get_contact{name:Maya}; sms.message literal hi; calendar.begin_time_millis needs_tool resolve_datetime{expression:next Friday at 6}\nLedger: sms.compose.phone, sms.compose.message, calendar.create_event.begin_time_millis -> final Workflow JSON",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Example request path: \"send message to Maya saying hi, invite him to a meeting next Friday at 6, add it to calendar\"\nAgent 0: t1 send_message target=Maya, t2 create_event time=next Friday at 6\nAgent 1: t1 -> sms.compose, t2 -> calendar.create_event\nAgent 2: sms.phone needs_tool get_contact{name:Maya}; sms.message literal hi; calendar.begin_time_millis needs_tool resolve_datetime{expression:next Friday at 6}\nLedger: sms.compose.phone, sms.compose.message, calendar.create_event.begin_time_millis -> final Workflow JSON",
      "autoResize": false,
      "lineHeight": 1.18
    },
