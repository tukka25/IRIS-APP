      "link": null,
      "locked": false,
      "text": "Agent 0\nTaskDecomposer\n\nInput: userRequest\nTools: none\nCatalog: none\n\nOutput tasks:\nid, description, target,\naction, app_hint,\nentity_mentions,\ntime_mentions\n\nAction enum:\nsend_message, make_call,\ncreate_event, set_alarm,\nopen_app, search, share,\nnavigate, play_media,\nopen_file, take_note,\ncheck_notification, other",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Agent 0\nTaskDecomposer\n\nInput: userRequest\nTools: none\nCatalog: none\n\nOutput tasks:\nid, description, target,\naction, app_hint,\nentity_mentions,\ntime_mentions\n\nAction enum:\nsend_message, make_call,\ncreate_event, set_alarm,\nopen_app, search, share,\nnavigate, play_media,\nopen_file, take_note,\ncheck_notification, other",
      "autoResize": false,
      "lineHeight": 1.12
    },
