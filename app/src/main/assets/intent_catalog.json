{
  "version": 2,
  "description": "Curated Android intent catalog — 18 apps + standard intents. Extras, URI templates, and examples documented from official sources and community research. Feed to the SLM so it can select specific intents with correct parameters.",
  "apps": [
    {
      "package": "com.spotify.music",
      "label": "Spotify",
      "triggers": ["playlist", "search", "focus", "workout", "chill", "music"],
      "intents": [
        {
          "id": "spotify.search_and_play",
          "action": "android.media.action.MEDIA_PLAY_FROM_SEARCH",
          "description": "Search Spotify and start playing the top result.",
          "params": [
            { "name": "query", "key": "android.intent.extra.QUERY", "type": "string", "required": true },
            { "name": "media_focus", "key": "android.media.extra.MEDIA_FOCUS", "type": "enum", "required": false, "values": ["vnd.android.cursor.item/playlist", "vnd.android.cursor.item/artist", "vnd.android.cursor.item/album", "vnd.android.cursor.item/audio"] }
          ],
          "example": { "query": "focus playlist", "media_focus": "vnd.android.cursor.item/playlist" }
        }
      ]
    },
    {
      "package": "com.whatsapp",
      "label": "WhatsApp",
      "triggers": ["message", "whatsapp", "send", "chat", "text"],
      "intents": [
        {
          "id": "whatsapp.send_text",
          "action": "android.intent.action.VIEW",
          "description": "Open WhatsApp and pre-fill a message to a phone number.",
          "params": [
            { "name": "phone", "key": null, "type": "string", "required": true },
            { "name": "text", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "https://wa.me/{phone}?text={text}",
          "example": { "phone": "971556778872", "text": "Hi, just checking in!" }
        }
      ]
    },
    {
      "package": "org.telegram.messenger",
      "label": "Telegram",
      "triggers": ["telegram", "message", "send", "chat", "channel"],
      "intents": [
        {
          "id": "telegram.open_profile",
          "action": "android.intent.action.VIEW",
          "description": "Open a Telegram user, channel, or bot profile.",
          "params": [
            { "name": "username", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "tg://resolve?domain={username}",
          "web_fallback": "https://t.me/{username}",
          "example": { "username": "durov" }
        },
        {
          "id": "telegram.send_message",
          "action": "android.intent.action.SEND",
          "description": "Share text to Telegram. Opens the contact picker, then pre-fills the message.",
          "params": [
            { "name": "text", "key": "android.intent.extra.TEXT", "type": "string", "required": true }
          ],
          "mime_type": "text/plain",
          "example": { "text": "Check this out!" }
        },
        {
          "id": "telegram.compose_message",
          "action": "android.intent.action.VIEW",
          "description": "Open Telegram compose screen with a pre-filled message.",
          "params": [
            { "name": "text", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "tg://msg?text={text}",
          "example": { "text": "Hello from iris" }
        },
        {
          "id": "telegram.share_url",
          "action": "android.intent.action.VIEW",
          "description": "Share a URL to Telegram for forwarding.",
          "params": [
            { "name": "url", "key": null, "type": "url", "required": true },
            { "name": "text", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "tg://msg_url?url={url}&text={text}",
          "example": { "url": "https://example.com", "text": "Thought you'd like this" }
        }
      ]
    },
    {
      "package": "com.instagram.android",
      "label": "Instagram",
      "triggers": ["instagram", "reel", "story", "profile", "photo", "post"],
      "intents": [
        {
          "id": "instagram.open_profile",
          "action": "android.intent.action.VIEW",
          "description": "Open an Instagram user profile.",
          "params": [
            { "name": "username", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://instagram.com/_u/{username}",
          "example": { "username": "instagram" }
        },
        {
          "id": "instagram.open_camera",
          "action": "android.intent.action.VIEW",
          "description": "Open the Instagram camera / post creation screen.",
          "params": [],
          "uri_template": "instagram://share",
          "example": {}
        }
      ]
    },
    {
      "package": "com.twitter.android",
      "label": "X / Twitter",
      "triggers": ["tweet", "twitter", "x", "post", "share"],
      "intents": [
        {
          "id": "twitter.compose_tweet",
          "action": "android.intent.action.VIEW",
          "description": "Open X/Twitter compose screen with pre-filled text.",
          "params": [
            { "name": "text", "key": null, "type": "string", "required": true },
            { "name": "url", "key": null, "type": "url", "required": false },
            { "name": "via", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "https://twitter.com/intent/tweet?text={text}&url={url}&via={via}",
          "example": { "text": "Check out this app!", "url": "https://example.com" }
        },
        {
          "id": "twitter.open_profile",
          "action": "android.intent.action.VIEW",
          "description": "Open an X/Twitter user profile.",
          "params": [
            { "name": "username", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://twitter.com/{username}",
          "example": { "username": "elonmusk" }
        }
      ]
    },
    {
      "package": "com.google.android.apps.maps",
      "label": "Google Maps",
      "triggers": ["map", "maps", "navigate", "directions", "location", "place", "nearby"],
      "intents": [
        {
          "id": "maps.search",
          "action": "android.intent.action.VIEW",
          "description": "Search for a place or address in Google Maps.",
          "params": [
            { "name": "query", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "geo:0,0?q={query}",
          "example": { "query": "coffee shop near me" }
        },
        {
          "id": "maps.navigate",
          "action": "android.intent.action.VIEW",
          "description": "Start turn-by-turn navigation to a destination.",
          "params": [
            { "name": "destination", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "google.navigation:q={destination}",
          "example": { "destination": "Dubai Mall" }
        },
        {
          "id": "maps.directions",
          "action": "android.intent.action.VIEW",
          "description": "Show directions between two places.",
          "params": [
            { "name": "origin", "key": null, "type": "string", "required": false },
            { "name": "destination", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://www.google.com/maps/dir/?api=1&origin={origin}&destination={destination}",
          "example": { "origin": "home", "destination": "gym" }
        }
      ]
    },
    {
      "package": "com.google.android.calendar",
      "label": "Calendar",
      "triggers": ["calendar", "event", "meeting", "schedule", "appointment"],
      "intents": [
        {
          "id": "calendar.add_event",
          "action": "android.intent.action.INSERT",
          "data_uri": "content://com.android.calendar/events",
          "description": "Open calendar to create a new event with pre-filled details.",
          "params": [
            { "name": "title", "key": "title", "type": "string", "required": true },
            { "name": "begin_time", "key": "beginTime", "type": "datetime_millis", "required": true },
            { "name": "end_time", "key": "endTime", "type": "datetime_millis", "required": false },
            { "name": "location", "key": "eventLocation", "type": "string", "required": false },
            { "name": "description", "key": "description", "type": "string", "required": false }
          ],
          "example": { "title": "Team meeting", "begin_time": 1770000000000, "location": "Office" }
        }
      ]
    },
    {
      "package": "com.google.android.apps.clock",
      "label": "Clock",
      "triggers": ["alarm", "clock", "wake", "timer"],
      "intents": [
        {
          "id": "clock.set_alarm",
          "action": "android.intent.action.SET_ALARM",
          "description": "Open clock app to set an alarm.",
          "params": [
            { "name": "hour", "key": "android.intent.extra.alarm.HOUR", "type": "int", "required": true },
            { "name": "minutes", "key": "android.intent.extra.alarm.MINUTES", "type": "int", "required": true },
            { "name": "message", "key": "android.intent.extra.alarm.MESSAGE", "type": "string", "required": false }
          ],
          "example": { "hour": 7, "minutes": 30, "message": "Morning workout" }
        },
        {
          "id": "clock.set_timer",
          "action": "android.intent.action.SET_TIMER",
          "description": "Open clock app to set a countdown timer.",
          "params": [
            { "name": "seconds", "key": "android.intent.extra.alarm.LENGTH", "type": "int", "required": true },
            { "name": "message", "key": "android.intent.extra.alarm.MESSAGE", "type": "string", "required": false }
          ],
          "example": { "seconds": 300, "message": "Tea timer" }
        }
      ]
    },
    {
      "package": "com.google.android.gm",
      "label": "Gmail",
      "triggers": ["email", "gmail", "mail"],
      "intents": [
        {
          "id": "gmail.compose",
          "action": "android.intent.action.SENDTO",
          "description": "Open Gmail compose with pre-filled fields.",
          "params": [
            { "name": "to", "key": null, "type": "string", "required": false },
            { "name": "subject", "key": null, "type": "string", "required": false },
            { "name": "body", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "mailto:{to}?subject={subject}&body={body}",
          "extra_params": [
            { "name": "cc", "key": "android.intent.extra.CC", "type": "string" },
            { "name": "bcc", "key": "android.intent.extra.BCC", "type": "string" }
          ],
          "example": { "to": "friend@example.com", "subject": "Meeting notes", "body": "Here are the notes" }
        }
      ]
    },
    {
      "package": "com.google.android.youtube",
      "label": "YouTube",
      "triggers": ["youtube", "video", "watch", "play"],
      "intents": [
        {
          "id": "youtube.search",
          "action": "android.intent.action.SEARCH",
          "description": "Open YouTube and search for videos.",
          "params": [
            { "name": "query", "key": "query", "type": "string", "required": true }
          ],
          "example": { "query": "workout motivation" }
        },
        {
          "id": "youtube.open_video",
          "action": "android.intent.action.VIEW",
          "description": "Open a specific YouTube video by ID.",
          "params": [
            { "name": "video_id", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://www.youtube.com/watch?v={video_id}",
          "example": { "video_id": "dQw4w9WgXcQ" }
        }
      ]
    },
    {
      "package": "com.android.chrome",
      "label": "Chrome",
      "triggers": ["browser", "web", "search", "google", "url", "link"],
      "intents": [
        {
          "id": "browser.open_url",
          "action": "android.intent.action.VIEW",
          "description": "Open a URL in the web browser.",
          "params": [
            { "name": "url", "key": null, "type": "url", "required": true }
          ],
          "uri_template": "{url}",
          "example": { "url": "https://www.google.com" }
        },
        {
          "id": "browser.search",
          "action": "android.intent.action.WEB_SEARCH",
          "description": "Search the web.",
          "params": [
            { "name": "query", "key": "query", "type": "string", "required": true }
          ],
          "example": { "query": "best coffee near me" }
        }
      ]
    },
    {
      "package": "com.android.phone",
      "label": "Phone",
      "triggers": ["call", "phone", "dial", "ring"],
      "intents": [
        {
          "id": "phone.dial",
          "action": "android.intent.action.DIAL",
          "description": "Open dialer with a pre-filled number (does not auto-call).",
          "params": [
            { "name": "phone", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "tel:{phone}",
          "example": { "phone": "+971556778872" }
        }
      ]
    },
    {
      "package": "com.android.mms",
      "label": "Messages",
      "triggers": ["sms", "text", "message"],
      "intents": [
        {
          "id": "sms.compose",
          "action": "android.intent.action.SENDTO",
          "description": "Open SMS app with pre-filled message.",
          "params": [
            { "name": "phone", "key": null, "type": "string", "required": true },
            { "name": "message", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "smsto:{phone}",
          "extra_params": [
            { "name": "message", "key": "sms_body", "type": "string" }
          ],
          "example": { "phone": "+971556778872", "message": "On my way!" }
        }
      ]
    },
    {
      "package": "com.netflix.mediaclient",
      "label": "Netflix",
      "triggers": ["netflix", "movie", "show", "watch", "play"],
      "intents": [
        {
          "id": "netflix.watch",
          "action": "android.intent.action.VIEW",
          "description": "Open Netflix and play a specific movie or show by ID.",
          "params": [
            { "name": "id", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://www.netflix.com/watch/{id}",
          "alternative_uri": "nflx://www.netflix.com/watch/{id}",
          "example": { "id": "70202141" }
        },
        {
          "id": "netflix.open_title",
          "action": "android.intent.action.VIEW",
          "description": "Open Netflix title page without auto-playing.",
          "params": [
            { "name": "id", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://www.netflix.com/title/{id}",
          "example": { "id": "80100172" }
        }
      ]
    },
    {
      "package": "com.Slack",
      "label": "Slack",
      "triggers": ["slack", "channel", "message", "team", "dm"],
      "intents": [
        {
          "id": "slack.open_channel",
          "action": "android.intent.action.VIEW",
          "description": "Open a Slack channel by team and channel ID.",
          "params": [
            { "name": "team", "key": null, "type": "string", "required": true },
            { "name": "channel", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "slack://channel?team={team}&id={channel}",
          "example": { "team": "T12345", "channel": "C67890" }
        },
        {
          "id": "slack.open_dm",
          "action": "android.intent.action.VIEW",
          "description": "Open a Slack direct message with a user.",
          "params": [
            { "name": "team", "key": null, "type": "string", "required": true },
            { "name": "user", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "slack://user?team={team}&id={user}",
          "example": { "team": "T12345", "user": "U67890" }
        }
      ]
    },
    {
      "package": "com.discord",
      "label": "Discord",
      "triggers": ["discord", "channel", "server", "dm", "voice"],
      "intents": [
        {
          "id": "discord.open_channel",
          "action": "android.intent.action.VIEW",
          "description": "Open a Discord channel or DM by channel ID.",
          "params": [
            { "name": "channel_id", "key": null, "type": "string", "required": true }
          ],
          "uri_template": "https://discord.com/channels/@me/{channel_id}",
          "example": { "channel_id": "123456789" }
        }
      ]
    },
    {
      "package": "com.ubercab",
      "label": "Uber",
      "triggers": ["uber", "ride", "taxi", "pickup", "dropoff"],
      "intents": [
        {
          "id": "uber.request_ride",
          "action": "android.intent.action.VIEW",
          "description": "Open Uber to request a ride with pre-filled pickup/dropoff.",
          "params": [
            { "name": "pickup_lat", "key": null, "type": "string", "required": false },
            { "name": "pickup_lng", "key": null, "type": "string", "required": false },
            { "name": "dropoff_lat", "key": null, "type": "string", "required": false },
            { "name": "dropoff_lng", "key": null, "type": "string", "required": false },
            { "name": "dropoff_name", "key": null, "type": "string", "required": false },
            { "name": "product_id", "key": null, "type": "string", "required": false }
          ],
          "uri_template": "uber://riderequest?pickup[latitude]={pickup_lat}&pickup[longitude]={pickup_lng}&dropoff[latitude]={dropoff_lat}&dropoff[longitude]={dropoff_lng}&dropoff[nickname]={dropoff_name}&product_id={product_id}",
          "web_fallback": "https://m.uber.com/looking",
          "example": { "pickup_lat": "37.775", "pickup_lng": "-122.418", "dropoff_lat": "37.802", "dropoff_lng": "-122.405", "dropoff_name": "Coit Tower" }
        }
      ]
    },
    {
      "package": "com.android.settings",
      "label": "Settings",
      "triggers": ["wifi", "bluetooth", "settings", "battery", "data", "airplane"],
      "intents": [
        {
          "id": "settings.wifi",
          "action": "android.settings.WIFI_SETTINGS",
          "description": "Open Wi-Fi settings.",
          "params": [],
          "example": {}
        },
        {
          "id": "settings.bluetooth",
          "action": "android.settings.BLUETOOTH_SETTINGS",
          "description": "Open Bluetooth settings.",
          "params": [],
          "example": {}
        },
        {
          "id": "settings.data_usage",
          "action": "android.settings.DATA_ROAMING_SETTINGS",
          "description": "Open mobile data settings.",
          "params": [],
          "example": {}
        }
      ]
    }
  ],
  "standard_intents": [
    {
      "id": "share.text",
      "action": "android.intent.action.SEND",
      "mime_type": "text/plain",
      "description": "Open Android share sheet with text. User picks which app to share to (WhatsApp, Telegram, Messages, etc.).",
      "params": [
        { "name": "text", "key": "android.intent.extra.TEXT", "type": "string", "required": true },
        { "name": "title", "key": "android.intent.extra.TITLE", "type": "string", "required": false }
      ],
      "example": { "text": "Check out this link!" }
    },
    {
      "id": "share.image",
      "action": "android.intent.action.SEND",
      "mime_type": "image/*",
      "description": "Open Android share sheet with an image.",
      "params": [
        { "name": "uri", "key": "android.intent.extra.STREAM", "type": "uri", "required": true }
      ],
      "example": { "uri": "content://media/external/images/media/1" }
    },
    {
      "id": "email.compose",
      "action": "android.intent.action.SENDTO",
      "data_uri": "mailto:",
      "description": "Open email app to compose with recipients, subject, and body.",
      "params": [
        { "name": "to", "key": "android.intent.extra.EMAIL", "type": "string", "required": false },
        { "name": "subject", "key": "android.intent.extra.SUBJECT", "type": "string", "required": false },
        { "name": "body", "key": "android.intent.extra.TEXT", "type": "string", "required": false }
      ],
      "example": { "to": "friend@example.com", "subject": "Hello", "body": "Just checking in" }
    }
  ]
}
