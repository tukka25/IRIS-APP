      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PackageCapabilityScanner\n\ninstalledAppsPromptSummary()\nresolvableActions(allIds)\n\nUses PackageManager to hide\nunavailable app actions before\nAgent 1 sees candidates",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "PackageCapabilityScanner\n\ninstalledAppsPromptSummary()\nresolvableActions(allIds)\n\nUses PackageManager to hide\nunavailable app actions before\nAgent 1 sees candidates",
      "autoResize": false,
      "lineHeight": 1.16
    },
