    {
      "id": "text_tool_registry",
      "type": "text",
      "x": 1162,
      "y": 616,
      "width": 286,
      "height": 206,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1027,
      "version": 1,
      "versionNonce": 100027,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ToolMetadataRegistry + ToolRegistry\n\nMetadata says:\nproduces + layerHints\n\nParameter tools:\nresolve_datetime\nget_contact\nsearch_places\nsearch_files\nsearch_media\nsearch_notes\nlist_installed_apps\ncalculator\n\nExecution tools are separate:\nsend_intent, open_uri,\nshare_text, set_alarm,\ncreate_calendar_event",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "ToolMetadataRegistry + ToolRegistry\n\nMetadata says:\nproduces + layerHints\n\nParameter tools:\nresolve_datetime\nget_contact\nsearch_places\nsearch_files\nsearch_media\nsearch_notes\nlist_installed_apps\ncalculator\n\nExecution tools are separate:\nsend_intent, open_uri,\nshare_text, set_alarm,\ncreate_calendar_event",
      "autoResize": false,
      "lineHeight": 1.14
    },
